# Environment Configuration Template
# Copy to .env and fill with real values
# NEVER commit .env - only commit .env.example

# Database
DB_HOST=localhost
DB_NAME=arriendo_facil_db
DB_USER=root
DB_PASSWORD=secure_password_here

# WordPress
WP_DEBUG=false
WP_DEBUG_LOG=false
ABSPATH=/path/to/wordpress

# Security
SECURE_AUTH_KEY=replace_with_wordpress_key_generator
SECURE_AUTH_SALT=replace_with_wordpress_key_generator
AF_ENABLE_2FA=false
AF_ENABLE_RATE_LIMITING=true

# Logging & Monitoring
AF_LOG_RETENTION_DAYS=30
AF_LOG_SENSITIVE_DATA=false
SENTRY_DSN=

# Encryption
AF_ENCRYPTION_ALGORITHM=secretbox
AF_ENCRYPT_AT_REST=true

# API Configuration
AF_API_ALLOWED_ORIGINS=https://arriendofacil.com
AF_REQUIRE_API_HTTPS=true

# Third-party APIs
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
SRI_ENDPOINT=https://sri.gob.ec/api
SRI_CERT_PASSWORD=your_cert_password

# Email
MAIL_DRIVER=sendgrid
SENDGRID_API_KEY=SG.xxx

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_ANALYTICS_TRACKING=false

# App Store
APPLE_TEAM_ID=XXXXXXXXXX
GOOGLE_PLAY_PACKAGE=com.arriendofacil.app
