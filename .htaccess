# Protege los archivos de desarrollo que viajan dentro del plugin.
#
# El directorio del plugin se sirve por HTTP, asi que sin estas reglas se
# pueden descargar composer.lock (versiones exactas de las dependencias),
# phpunit.xml, la carpeta docs/ y -- si el despliegue copio el repositorio
# completo -- el directorio .git con todo el codigo fuente.
#
# El bloque solo niega archivos que nunca son assets: assets/css y assets/js
# siguen sirviendo con normalidad.

# Archivos ocultos (.git, .env, .phpunit.result.cache, .htaccess, ...).
<IfModule mod_authz_core.c>
	<FilesMatch "^\.">
		Require all denied
	</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
	<FilesMatch "^\.">
		Order deny,allow
		Deny from all
	</FilesMatch>
</IfModule>

# Documentacion, configuracion de desarrollo y respaldos.
<IfModule mod_authz_core.c>
	<FilesMatch "\.(?:md|txt|xml|lock|cache|ini|log|sql|bak|old|orig|dist|map|sample)$">
		Require all denied
	</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
	<FilesMatch "\.(?:md|txt|xml|lock|cache|ini|log|sql|bak|old|orig|dist|map|sample)$">
		Order deny,allow
		Deny from all
	</FilesMatch>
</IfModule>

# composer.json declara las dependencias exactas con sus versiones.
<Files "composer.json">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order deny,allow
		Deny from all
	</IfModule>
</Files>

# Utilidad de linea de comandos: nunca debe ejecutarse via web.
<Files "CONVERTIDOR_P12_VALIDO.php">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order deny,allow
		Deny from all
	</IfModule>
</Files>

# Directorios que solo existen en desarrollo. En un .htaccess por directorio
# el patron se evalua contra la ruta relativa, asi que no depende del nombre
# de la carpeta del plugin.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^(?:docs|tests|vendor|node_modules|bin|\.git|\.svn|\.github)(?:/|$) - [F,L]
</IfModule>
